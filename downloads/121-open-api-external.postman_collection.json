    },
    {
      "key": "fundPlanId",
      "value": "",
      "type": "string"
    },
    {
      "key": "materialCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "budgetMonth",
      "value": "",
      "type": "string"
    },
    {
      "key": "purchaseDate",
