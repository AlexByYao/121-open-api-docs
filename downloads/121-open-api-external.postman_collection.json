            "header": [],
            "url": "{{baseUrl}}/dictionaries/provinces?deptId={{departmentId}}&pageNum=1&pageSize=100",
            "description": "查询省份，预期HTTP 200、数字code=200；按分页遍历全部结果。"
          }
        },
        {
          "name": "D01 销售渠道",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dictionaries/sale-channels?deptId={{departmentId}}&pageNum=1&pageSize=100",
            "description": "查询销售渠道，预期HTTP 200、数字code=200；按分页遍历全部结果。"
          }
        },
        {
          "name": "D01 付款方式",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dictionaries/payment-methods?deptId={{departmentId}}&pageNum=1&pageSize=100",
            "description": "查询付款方式，预期HTTP 200、数字code=200；按分页遍历全部结果。"
          }
        },
        {
