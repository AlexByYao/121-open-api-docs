            "description": "产品经理须在当前部门；其他有效审批角色可跨部门。预期HTTP 200、数字code=200。"
          }
        },
        {
          "name": "D01 审批人员：总经理",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dictionaries/approval-users?deptId={{departmentId}}&roleCode=GENERAL_MANAGER&pageNum=1&pageSize=100",
            "description": "产品经理须在当前部门；其他有效审批角色可跨部门。预期HTTP 200、数字code=200。"
          }
        }
      ]
    },
    {
      "name": "02 采购草稿（手动逐项执行）",
      "description": "创建和取消会修改测试环境数据。仅使用双方准备的专用测试数据，逐项Send，不要对整个文件夹运行Runner。",
      "item": [
        {
          "name": "P01 创建草稿／原样重试",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/purchase-drafts",
            "description": "首次预期DRAFT；同正文、同批次、同幂等键重试返回同一draftId。将返回draftId手动保存为环境变量。 供应商requiresProject=true时，在Body补projectId；cashCycle=30仅为当前协议示例，实际周期需双方确认，不能将附件月份或0值直接代入。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceSystem\": \"INTELLIGENT_OFFICE\",\n  \"sourceOrderId\": \"{{sourceOrderId}}\",\n  \"syncBatchId\": \"{{syncBatchId}}\",\n  \"operatorLoginAccount\": \"{{loginAccount}}\",\n  \"initiatorLoginAccount\": \"{{loginAccount}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"authorized\": true,\n  \"storeId\": \"{{storeId}}\",\n  \"provinceId\": \"{{provinceId}}\",\n  \"saleChannelId\": \"{{saleChannelId}}\",\n  \"fundPlanId\": \"{{fundPlanId}}\",\n  \"transportCost\": 0,\n  \"taxRate\": 0.13,\n  \"cashCycle\": 30,\n  \"budgetMonth\": \"{{budgetMonth}}\",\n  \"purchaseDate\": \"{{purchaseDate}}\",\n  \"details\": [\n    {\n      \"sourceDetailId\": \"line-1\",\n      \"materialCode\": \"{{materialCode}}\",\n      \"quantity\": 10,\n      \"purchasePrice\": 100,\n      \"purchaseAmount\": 1000,\n      \"salesQuantity\": 10,\n      \"salesPrice\": 120,\n      \"inventoryQuantity\": 50\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "P02 按来源查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/purchase-drafts/by-source?sourceSystem=INTELLIGENT_OFFICE&sourceOrderId={{sourceOrderId}}&syncBatchId={{syncBatchId}}",
            "description": "必须使用本次创建的sourceOrderId与syncBatchId；创建超时先查此接口，不自动选择最近批次。"
          }
        },
        {
          "name": "P03 按121 ID查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/purchase-drafts/{{draftId}}",
            "description": "draftId填写P01返回的applyId；只返回状态和首次同步明细映射，不是当前完整明细。"
          }
        },
        {
          "name": "P04 取消本次测试草稿（选测）",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/purchase-drafts/{{draftId}}/cancel",
            "description": "仅手动取消本次创建的未锁单测试草稿，预期DELETED；锁单等状态应409/DRAFT_NOT_EDITABLE。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operatorLoginAccount\": \"{{loginAccount}}\",\n  \"reason\": \"双方联调测试取消\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
