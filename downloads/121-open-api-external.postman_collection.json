{
  "info": {
    "name": "121 智能化开放接口 · 外部测试",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "配套接口文档1.1.7。先导入测试环境并填写121线下交付的凭据与专用测试数据；集合级发送前脚本自动HMAC签名。先逐项执行只读请求，再手动创建/查询/取消专用测试草稿。不要对整个集合运行Runner。C01由智能化提供接收地址，121发起投递验收，不在此集合中冒充121接口。接口地址是否可用以121验收通知为准。"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://testfcst.chinaptac.com/open-api/v1",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "keyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "hmacSecret",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginAccount",
      "value": "",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sourceOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "syncBatchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "draftId",
      "value": "",
      "type": "string"
    },
    {
      "key": "supplierId",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "provinceId",
      "value": "",
      "type": "string"
