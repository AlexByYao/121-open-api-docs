          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dictionaries/fund-plans?deptId={{departmentId}}&pageNum=1&pageSize=100",
            "description": "查询资金计划，预期HTTP 200、数字code=200；按分页遍历全部结果。"
          }
