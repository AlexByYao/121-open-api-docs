            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "02 采购草稿（手动逐项执行）",
      "description": "创建和取消会修改测试环境数据。仅使用双方准备的专用测试数据，逐项Send，不要对整个文件夹运行Runner。",
      "item": [
        {
          "name": "P01 创建草稿／原样重试",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "App-Id",
                "value": "{{appId}}",
                "type": "text"
              },
              {
                "key": "App-Secret",
                "value": "{{appSecret}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              },
              {
                "key": "loginAccount",
                "value": "{{loginAccount}}",
                "type": "text",
                "description": "121账号最多30个字符；含中文或百分号时先UTF-8百分号编码"
              }
            ],
            "url": "{{baseUrl}}/purchase-drafts",
            "description": "sourceOrderId为调用方保存的采购记录ID；Idempotency-Key使用已保存的唯一键（可用UUID）。超时重试保持账号、来源记录ID、幂等键及原始正文不变。sourceSystem可省略。成功返回DRAFT及draftId，主单或明细失败整体回滚。\n2.8.1：purchaseAmount选填，省略/null由121计算，提供时须精确等于数量×单价。运费可手填。requiresProject=false允许省略项目，即使库位绑定项目也不会自动带出；主动传项目时须匹配库位。原单不可访问404 DRAFT_NOT_FOUND；同来源有效原单可访问409 SOURCE_ALREADY_SYNCED；幂等内容冲突优先409 IDEMPOTENCY_CONFLICT。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceOrderId\": \"{{sourceOrderId}}\",\n  \"deptId\": \"{{deptId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"authorized\": true,\n  \"storeId\": \"{{storeId}}\",\n  \"provinceId\": \"{{provinceId}}\",\n  \"saleChannelId\": \"{{saleChannelId}}\",\n  \"fundPlanId\": \"{{fundPlanId}}\",\n  \"transportCost\": 0,\n  \"taxRate\": 0.13,\n  \"cashCycle\": 30,\n  \"budgetMonth\": \"{{budgetMonth}}\",\n  \"purchaseDate\": \"{{purchaseDate}}\",\n  \"details\": [\n    {\n      \"sourceDetailId\": \"line-1\",\n      \"materialCode\": \"{{materialCode}}\",\n      \"quantity\": 10,\n      \"purchasePrice\": 100,\n      \"purchaseAmount\": 1000,\n      \"salesQuantity\": 10,\n      \"salesPrice\": 120,\n      \"inventoryQuantity\": 50\n    }\n  ],\n  \"discount\": 0,\n  \"advance\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "P02 按来源记录和幂等键查询",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "App-Id",
                "value": "{{appId}}",
                "type": "text"
              },
              {
                "key": "App-Secret",
                "value": "{{appSecret}}",
                "type": "text"
              },
              {
                "key": "loginAccount",
                "value": "{{loginAccount}}",
                "type": "text",
                "description": "121账号最多30个字符；含中文或百分号时先UTF-8百分号编码"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/purchase-drafts/by-source?sourceOrderId={{sourceOrderId}}",
            "description": "Query传原sourceOrderId，Header传原Idempotency-Key；创建超时先查询本接口。sourceSystem可省略。只查询当前账号及应用授权范围内、与原键匹配的采购单。",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "P03 按121 ID查询",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "App-Id",
                "value": "{{appId}}",
                "type": "text"
              },
              {
                "key": "App-Secret",
                "value": "{{appSecret}}",
                "type": "text"
              },
              {
                "key": "loginAccount",
                "value": "{{loginAccount}}",
                "type": "text",
                "description": "121账号最多30个字符；含中文或百分号时先UTF-8百分号编码"
              }
            ],
            "url": "{{baseUrl}}/purchase-drafts/{{draftId}}",
            "description": "draftId填写P01返回的applyId；只返回状态和首次同步明细映射，不是当前完整明细。\n公共loginAccount必填，仅可查询和操作该用户可用部门。",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "P04 取消本次测试草稿（选测）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "App-Id",
                "value": "{{appId}}",
                "type": "text"
              },
              {
                "key": "App-Secret",
                "value": "{{appSecret}}",
                "type": "text"
              },
              {
                "key": "loginAccount",
                "value": "{{loginAccount}}",
                "type": "text",
                "description": "121账号最多30个字符；含中文或百分号时先UTF-8百分号编码"
              }
            ],
            "url": "{{baseUrl}}/purchase-drafts/{{draftId}}/cancel",
            "description": "仅手动取消本次创建的未锁单测试草稿，预期DELETED；锁单等状态应409/DRAFT_NOT_EDITABLE。\n公共loginAccount必填，仅可查询和操作该用户可用部门。\n当前失败message可能为英文，按errorCode处理；409 DRAFT_NOT_EDITABLE表示非草稿或状态已变化。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"双方联调测试取消\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
